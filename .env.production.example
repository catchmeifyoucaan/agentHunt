# AgentHunt Production Configuration (Digital Ocean)

# ====================================
# SERVER CONFIGURATION
# ====================================
NODE_ENV=production
PORT=3000
API_VERSION=v1
LOG_LEVEL=info

# ====================================
# DATABASE (Digital Ocean Managed PostgreSQL)
# ====================================
# Get from: Digital Ocean > Databases > Your PostgreSQL Cluster > Connection Details
POSTGRES_HOST=your-db-cluster-do-user-123456-0.b.db.ondigitalocean.com
POSTGRES_PORT=25060
POSTGRES_USER=doadmin
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=agenthunt
# Enable SSL for managed database
POSTGRES_SSL=true

# ====================================
# REDIS (Digital Ocean Managed Redis)
# ====================================
# Get from: Digital Ocean > Databases > Your Redis Cluster > Connection Details
REDIS_HOST=your-redis-cluster-do-user-123456-0.b.db.ondigitalocean.com
REDIS_PORT=25061
REDIS_PASSWORD=your_redis_password
# Enable TLS for managed Redis
REDIS_TLS=true

# ====================================
# STORAGE (Digital Ocean Spaces - S3 Compatible)
# ====================================
# Get from: Digital Ocean > API > Spaces Keys
# Spaces endpoint format: https://{region}.digitaloceanspaces.com
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_ACCESS_KEY=your_spaces_access_key
S3_SECRET_KEY=your_spaces_secret_key
S3_BUCKET=agenthunt-artifacts
S3_REGION=nyc3
# Enable SSL (already in endpoint URL)
S3_FORCE_PATH_STYLE=true

# ====================================
# AI PROVIDERS (Multi-Provider with Fallback)
# ====================================
# AgentHunt supports multiple AI providers with automatic fallback
# Priority order: Perplexity → Gemini → OpenAI → Claude
# At least ONE provider is required

# Perplexity AI (Recommended - Fast & Cheap)
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PERPLEXITY_MODEL=llama-3.1-sonar-huge-128k-online
ENABLE_PERPLEXITY=true

# Google Gemini (Free Tier Available)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-pro
ENABLE_GEMINI=true

# OpenAI (Reliable)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
ENABLE_OPENAI=true

# Anthropic Claude (Premium)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ENABLE_ANTHROPIC=true

# AI Configuration
TRIAGE_TEMPERATURE=0.0
MANAGER_TEMPERATURE=0.3

# ====================================
# CHAOS DB (Required for Asset Discovery)
# ====================================
# Get from: https://chaos.projectdiscovery.io/
CHAOS_API_KEY=your_chaos_api_key_here
CHAOS_API_URL=https://chaos.projectdiscovery.io

# ====================================
# TELEGRAM NOTIFICATIONS (Optional but Recommended)
# ====================================
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz1234567890
# Channel IDs (create channels, add bot as admin, get ID from @userinfobot)
TELEGRAM_CRITICAL_CHANNEL=-1001234567890
TELEGRAM_HIGH_CHANNEL=-1001234567891
TELEGRAM_OPS_CHANNEL=-1001234567892

# ====================================
# SECURITY (IMPORTANT: Change these!)
# ====================================
JWT_SECRET=$(openssl rand -base64 32)
JWT_EXPIRES_IN=24h
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ====================================
# WORKER CONFIGURATION
# ====================================
MAX_CONCURRENT_JOBS=20
WORKER_CONCURRENCY=10
JOB_TIMEOUT_MS=3600000
JOB_RETRY_ATTEMPTS=3

# ====================================
# TOOL PATHS (Installed via Docker)
# ====================================
CHAOS_CLIENT_PATH=/usr/local/bin/chaos-client
SUBFINDER_PATH=/usr/local/bin/subfinder
NUCLEI_PATH=/usr/local/bin/nuclei
HTTPX_PATH=/usr/local/bin/httpx
KATANA_PATH=/usr/local/bin/katana
NAABU_PATH=/usr/local/bin/naabu
DNSX_PATH=/usr/local/bin/dnsx
TLSX_PATH=/usr/local/bin/tlsx
SHUFFLEDNS_PATH=/usr/local/bin/shuffledns
MASSDNS_PATH=/usr/local/bin/massdns

# ====================================
# TEMPLATE & WORDLIST PATHS
# ====================================
NUCLEI_TEMPLATES_PATH=/app/tools/templates/nuclei
WORDLIST_PATH=/app/tools/wordlists

# ====================================
# SAFETY & COMPLIANCE
# ====================================
ENABLE_TIER_3_TEMPLATES=false
REQUIRE_HUMAN_APPROVAL_HIGH=true
REQUIRE_HUMAN_APPROVAL_CRITICAL=true
MAX_FUZZING_CONCURRENCY=30
FP_THRESHOLD_HIGH=0.02
FP_THRESHOLD_CRITICAL=0.02

# ====================================
# INTERACTSH (Out-of-Band Testing)
# ====================================
INTERACTSH_SERVER=oast.pro
INTERACTSH_TOKEN=

# ====================================
# MONITORING & OBSERVABILITY
# ====================================
ENABLE_TELEMETRY=true
SENTRY_DSN=
GRAFANA_URL=

# ====================================
# FEATURE FLAGS
# ====================================
ENABLE_BRUTEFORCE=false
ENABLE_PORT_SCANNING=false
ENABLE_FUZZING=true
ENABLE_AI_TRIAGE=true
ENABLE_AUTO_CONFIRM=true

# ====================================
# BUG BOUNTY PLATFORM INTEGRATIONS (Optional)
# ====================================
# HackerOne API (Get from: Settings > API Tokens)
HACKERONE_API_TOKEN=
HACKERONE_API_USERNAME=

# Bugcrowd API (Get from: Settings > API Access)
BUGCROWD_API_KEY=
BUGCROWD_API_SECRET=

# ====================================
# CORS & FRONTEND
# ====================================
# Set this to your frontend domain
CORS_ORIGIN=https://agenthunt.yourdomain.com
FRONTEND_URL=https://agenthunt.yourdomain.com
