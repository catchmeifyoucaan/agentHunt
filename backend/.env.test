# Test Environment Variables
NODE_ENV=test

# Database (use separate test database)
DATABASE_URL=postgresql://user:password@localhost:5432/agenthunt_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agenthunt_test
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Redis (use separate test instance or DB)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# API Keys (use test keys or mock values)
ANTHROPIC_API_KEY=test_anthropic_key
OPENAI_API_KEY=test_openai_key
GOOGLE_API_KEY=test_google_key

# AWS (mock values for testing)
AWS_ACCESS_KEY_ID=test_access_key
AWS_SECRET_ACCESS_KEY=test_secret_key
AWS_REGION=us-east-1
S3_BUCKET=test-bucket

# Application
PORT=3001
JWT_SECRET=test_jwt_secret_key_for_testing_only
API_RATE_LIMIT=1000

# Feature Flags
ENABLE_TELEMETRY=false
ENABLE_SANDBOX=false
ENABLE_MONITORING=false

# Logging
LOG_LEVEL=error
