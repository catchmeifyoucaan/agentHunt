#!/usr/bin/env python3
"""
gcli — Gradient GPT-5 command-line client

Usage:
  gcli "single prompt"
  gcli                # interactive REPL
  gcli --model openai-gpt-5 --no-history "prompt"
  gcli --reset-config

Config & history:
  ~/.gcli/config.json
  ~/.gcli/history.json
"""
import argparse
import json
import os
import sys
import textwrap
from pathlib import Path
from typing import List, Dict, Any, Optional

# Try to import gradient SDK
try:
    from gradientai import Gradient
except Exception as e:
    print("Error: gradient SDK not found. Install with: pip install gradientai")
    raise SystemExit(1)

# Optional nice terminal output
try:
    from rich.console import Console
    from rich.markdown import Markdown
    console = Console()
    def print_rich(text: str):
        console.print(Markdown(text))
    def print_info(text: str):
        console.print(f"[bold cyan]{text}[/]")
    def print_err(text: str):
        console.print(f"[bold red]{text}[/]")
except Exception:
    console = None
    def print_rich(text: str):
        print(text)
    def print_info(text: str):
        print(text)
    def print_err(text: str):
        print(text, file=sys.stderr)

# File locations
HOME = Path.home()
GCLI_DIR = HOME / ".gcli"
CONFIG_FILE = GCLI_DIR / "config.json"
HISTORY_FILE = GCLI_DIR / "history.json"

DEFAULT_MODEL = "openai-gpt-5"
MAX_HISTORY_ITEMS = 50  # keep history bounded

def ensure_dirs():
    GCLI_DIR.mkdir(parents=True, exist_ok=True)

def load_config() -> Dict[str, Any]:
    ensure_dirs()
    if CONFIG_FILE.exists():
        try:
            return json.loads(CONFIG_FILE.read_text())
        except Exception:
            return {}
    return {}

def save_config(cfg: Dict[str, Any]):
    ensure_dirs()
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2))

def load_history() -> List[Dict[str, str]]:
    ensure_dirs()
    if HISTORY_FILE.exists():
        try:
            return json.loads(HISTORY_FILE.read_text())
        except Exception:
            return []
    return []

def save_history(history: List[Dict[str, str]]):
    ensure_dirs()
    HISTORY_FILE.write_text(json.dumps(history[-MAX_HISTORY_ITEMS:], indent=2))

def get_api_key(cfg: Dict[str, Any]) -> Optional[str]:
    key = os.environ.get("MODEL_ACCESS_KEY") or cfg.get("model_access_key")
    if key:
        return key
    if sys.stdin.isatty():
        print_info("No MODEL_ACCESS_KEY found in env or config.")
        k = input("Paste your Gradient MODEL_ACCESS_KEY (it will be saved to ~/.gcli/config.json): ").strip()
        if k:
            cfg["model_access_key"] = k
            save_config(cfg)
            return k
    return None

def init_client() -> Gradient:
    client = Gradient()
    return client

def build_messages(history: List[Dict[str,str]], user_prompt: str) -> List[Dict[str,str]]:
    msgs = []
    for item in history[-MAX_HISTORY_ITEMS:]:
        role = item.get("role")
        content = item.get("content")
        if role and content:
            msgs.append({"role": role, "content": content})
    msgs.append({"role": "user", "content": user_prompt})
    return msgs

def call_model(client: Gradient, model: str, messages: List[Dict[str,str]], api_key: str, max_tokens: int = 512) -> str:
    try:
        response = client.chat.completions.create(
            model=model,
            messages=messages,
            max_tokens=max_tokens,
            model_access_key=api_key
        )
    except Exception as e:
        raise RuntimeError(f"API call failed: {e}")
    try:
        choice = response.choices[0]
        content = None
        if hasattr(choice, "message") and hasattr(choice.message, "content"):
            content = choice.message.content
        else:
            c = choice.get("message") if isinstance(choice, dict) else None
            if c:
                content = c.get("content", "")
        if content is None:
            content = getattr(choice, "text", None) or (choice.get("text") if isinstance(choice, dict) else None) or ""
        return content
    except Exception:
        try:
            if isinstance(response, dict):
                return response["choices"][0]["message"]["content"]
        except Exception:
            pass
        raise RuntimeError("Unexpected API response structure. Inspect the variable 'response' for details.")

def pretty_print_response(text: str):
    print_info("\n=== Assistant ===")
    print_rich(text)
    print_info("=================\n")

def interactive_mode(client: Gradient, model: str, cfg: Dict[str,Any], api_key: str):
    history = load_history()
    print_info(f"Interactive mode. Model: {model}. Type /help for commands.")
    while True:
        try:
            prompt = input("\nYou: ").strip()
        except (KeyboardInterrupt, EOFError):
            print_info("\nExiting.")
            return
        if not prompt:
            continue
        if prompt.startswith("/"):
            cmd = prompt[1:].strip().lower()
            if cmd in ("quit", "exit"):
                print_info("Bye.")
                return
            if cmd == "history":
                hist = load_history()
                for i, h in enumerate(hist[-MAX_HISTORY_ITEMS:]):
                    role = h.get("role")
                    content = h.get("content")
                    text = content[:200].replace('\n',' ')
                    print(f"[{i}] {role}: {text}")
                continue
            if cmd == "clear":
                confirm = input("Clear saved history? (yes/no): ").strip().lower()
                if confirm in ("y","yes"):
                    save_history([])
                    print_info("Saved history cleared.")
                continue
            if cmd == "help":
                print_info(textwrap.dedent(
                    """
                    Commands:
                      /help       Show this help
                      /history    Show last saved messages
                      /clear      Clear saved history
                      /exit       Quit
                      /model      Show current model
                    """
                ))
                continue
            if cmd == "model":
                print_info(f"Current model: {model}")
                continue
            print_err(f"Unknown command: {cmd}")
            continue

        messages = build_messages(history, prompt)
        try:
            resp_text = call_model(client, model, messages, api_key)
        except Exception as e:
            print_err(f"API error: {e}")
            continue

        history.append({"role":"user","content": prompt})
        history.append({"role":"assistant","content": resp_text})
        save_history(history)
        pretty_print_response(resp_text)

def one_shot_mode(client: Gradient, model: str, prompt: str, api_key: str, no_history: bool = False):
    history = [] if no_history else load_history()
    messages = build_messages(history, prompt)
    resp_text = call_model(client, model, messages, api_key)
    if not no_history:
        history.append({"role":"user","content": prompt})
        history.append({"role":"assistant","content": resp_text})
        save_history(history)
    pretty_print_response(resp_text)

def main():
    parser = argparse.ArgumentParser(prog="gcli", description="Gradient GPT CLI - use your Gradient model endpoint from terminal.")
    parser.add_argument("prompt", nargs="*", help="Prompt to send (if omitted, enters interactive mode).")
    parser.add_argument("--model", default=None, help=f"Model id to use (default {DEFAULT_MODEL})")
    parser.add_argument("--no-history", action="store_true", help="Do not load or save local history for this call.")
    parser.add_argument("--reset-config", action="store_true", help="Reset saved config (deletes ~/.gcli/config.json).")
    args = parser.parse_args()

    if args.reset_config:
        if CONFIG_FILE.exists():
            CONFIG_FILE.unlink()
        if HISTORY_FILE.exists():
            HISTORY_FILE.unlink()
        print_info("Config and history reset.")
        return

    cfg = load_config()
    api_key = get_api_key(cfg)
    if not api_key:
        print_err("No API key found and input is not interactive. Set MODEL_ACCESS_KEY env var or run interactively.")
        return

    client = init_client()
    model = args.model or cfg.get("default_model") or DEFAULT_MODEL

    if cfg.get("default_model") != model:
        cfg["default_model"] = model
        save_config(cfg)

    if args.prompt:
        prompt = " ".join(args.prompt).strip()
        one_shot_mode(client, model, prompt, api_key, no_history=args.no_history)
    else:
        interactive_mode(client, model, cfg, api_key)

if __name__ == "__main__":
    main()
