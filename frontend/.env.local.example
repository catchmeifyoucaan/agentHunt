# AgentHunt Frontend - Local Development

# ====================================
# API BACKEND URL (Local Development)
# ====================================
NEXT_PUBLIC_API_URL=http://localhost:3000

# ====================================
# WEBSOCKET URL (Optional)
# ====================================
# Uncomment if WebSocket is on different port
# NEXT_PUBLIC_WS_URL=ws://localhost:3000

# ====================================
# PHOENIX OBSERVABILITY URL
# ====================================
# For DigitalOcean deployment, use your droplet IP:
# NEXT_PUBLIC_PHOENIX_URL=http://YOUR_DROPLET_IP:6006
# For local development:
NEXT_PUBLIC_PHOENIX_URL=http://localhost:6006

# ====================================
# ENVIRONMENT
# ====================================
NODE_ENV=development
