# AgentHunt Configuration

# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1
LOG_LEVEL=info

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agenthunt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agenthunt

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agenthunt-artifacts
S3_REGION=us-east-1

# ==============================================
# AI PROVIDERS (Multi-Provider with Fallback)
# ==============================================
# AgentHunt supports multiple AI providers with automatic fallback
# Priority order: Perplexity → Gemini → OpenAI → Claude
# At least ONE provider is required

# Perplexity AI (Recommended - Fast & Cheap)
PERPLEXITY_API_KEY=pplx-your_key_here
PERPLEXITY_MODEL=llama-3.1-sonar-huge-128k-online
ENABLE_PERPLEXITY=true

# Google Gemini (Free Tier Available)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
ENABLE_GEMINI=true

# OpenAI (Reliable)
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o
ENABLE_OPENAI=true

# Anthropic Claude (Premium)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ENABLE_ANTHROPIC=true

# AI Configuration
TRIAGE_TEMPERATURE=0.0
MANAGER_TEMPERATURE=0.3

# Chaos DB
CHAOS_API_KEY=your_chaos_api_key_here
CHAOS_API_URL=https://chaos.projectdiscovery.io

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CRITICAL_CHANNEL=-1001234567890
TELEGRAM_HIGH_CHANNEL=-1001234567891
TELEGRAM_OPS_CHANNEL=-1001234567892

# Security
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Worker Configuration
MAX_CONCURRENT_JOBS=10
WORKER_CONCURRENCY=5
JOB_TIMEOUT_MS=3600000
JOB_RETRY_ATTEMPTS=3

# Tool Paths (Docker will override these)
CHAOS_CLIENT_PATH=/usr/local/bin/chaos-client
SUBFINDER_PATH=/usr/local/bin/subfinder
NUCLEI_PATH=/usr/local/bin/nuclei
HTTPX_PATH=/usr/local/bin/httpx
KATANA_PATH=/usr/local/bin/katana
NAABU_PATH=/usr/local/bin/naabu
DNSX_PATH=/usr/local/bin/dnsx
TLSX_PATH=/usr/local/bin/tlsx
SHUFFLEDNS_PATH=/usr/local/bin/shuffledns
MASSDNS_PATH=/usr/local/bin/massdns

# Template Configuration
NUCLEI_TEMPLATES_PATH=/app/tools/templates/nuclei
WORDLIST_PATH=/app/tools/wordlists

# Safety Configuration
ENABLE_TIER_3_TEMPLATES=false
REQUIRE_HUMAN_APPROVAL_HIGH=true
REQUIRE_HUMAN_APPROVAL_CRITICAL=true
MAX_FUZZING_CONCURRENCY=20
FP_THRESHOLD_HIGH=0.02
FP_THRESHOLD_CRITICAL=0.02

# Interactsh (OOB)
INTERACTSH_SERVER=oast.pro
INTERACTSH_TOKEN=

# Monitoring
ENABLE_TELEMETRY=true
SENTRY_DSN=
GRAFANA_URL=

# Feature Flags
ENABLE_BRUTEFORCE=false
ENABLE_PORT_SCANNING=false
ENABLE_FUZZING=true
ENABLE_AI_TRIAGE=true
ENABLE_AUTO_CONFIRM=true
